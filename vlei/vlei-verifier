#!/usr/bin/env bash
# Entry point of the vLEI verifier for the EVM attester (see README.md, section "Verifiers contract").
# Standard output: one JSON object. Return code: 0 true verdict, 1 false verdict, 2 error.
# Paths given as arguments are read from the caller's current folder.
set -euo pipefail
ICI="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONWARNINGS="ignore"
export PYTHONPATH="$ICI${PYTHONPATH:+:$PYTHONPATH}"
export DYLD_FALLBACK_LIBRARY_PATH="$ICI/.deps/libsodium/lib${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"
exec "$ICI/.venv/bin/python" -m verifier "$@"
